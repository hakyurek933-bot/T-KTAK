# Örnek ortam değişkenleri. Vercel panelinde aynı isimlerle tanımlayın.
# Postgres bağlantısı (Neon / Vercel Postgres / Supabase).
# Uygulama havuzlu bağlantıyı kullanabilir; şema kurulumu için havuzsuz bağlantı önerilir.
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://kullanici:sifre@host/veritabani?sslmode=require"
AUTH_SECRET="rastgele-uzun-bir-anahtar-uret"
FOUNDER_USERNAME="kurucu"
FOUNDER_PASSWORD="guclu-bir-sifre"
FOUNDER_DISPLAY_NAME="Kurucu"
FOUNDER_EMAIL="kurucu@ornek.com"
SEED_DEMO="false"
BLOB_READ_WRITE_TOKEN=""
# Google ile giriş (https://console.cloud.google.com/apis/credentials)
# Redirect URI: https://alan-adin/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="https://alan-adin"
# E-posta doğrulama (Resend). Boş bırakılırsa doğrulama otomatik geçilir.
RESEND_API_KEY=""
EMAIL_FROM="Taktik <noreply@alan-adin>"
# Gerçek kamera yayını (LiveKit Cloud, ücretsiz katman: cloud.livekit.io).
# Boş bırakılırsa yayınlar video fonu modunda çalışır.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# GIF araması (Tenor). Boş bırakılırsa GIF sekmesi bilgilendirir.
TENOR_API_KEY=""
