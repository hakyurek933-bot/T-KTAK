// Prisma şeması — Taktik (yerli TikTok benzeri platform)
// Üretimde PostgreSQL (Vercel Postgres / Neon / Supabase) kullanılır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roller: FOUNDER (kurucu), MOD (moderatör), USER (normal)
enum Role {
  FOUNDER
  MOD
  USER
}

enum LogAction {
  SIGNUP
  LOGIN
  LOGOUT
  POST_CREATE
  POST_DELETE
  COMMENT_CREATE
  COMMENT_DELETE
  EMAIL_VERIFY
  LIVE_START
  LIVE_END
  GIFT_SEND
  COIN_ADJUST
  DAILY_BONUS
  STORY_CREATE
  STORY_DELETE
  REPORT_CREATE
  REPORT_REVIEW
  BLOCK
  UNBLOCK
  PK_START
  PK_END
  POLL_START
  LIVE_MUTE
  MESSAGE_SEND
  BAN
  UNBAN
  ROLE_CHANGE
}

enum LiveStatus {
  LIVE
  ENDED
}

enum CoinReason {
  SIGNUP_BONUS
  DAILY_BONUS
  UPLOAD_REWARD
  GIFT_SENT
  GIFT_EARNED
  ADMIN_ADJUST
  PROMOTE
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
  FOLLOW
  MENTION
  LIVE
}

enum ReportTarget {
  POST
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum PkStatus {
  PENDING
  ACCEPTED
  DECLINED
  ENDED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  email        String?  @unique
  emailVerified Boolean @default(false)
  googleId     String?  @unique
  kickId       String?  @unique
  birthdate    DateTime?
  passwordHash String
  role         Role     @default(USER)
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  banned       Boolean  @default(false)
  bannedReason String?
  bannedAt     DateTime?
  createdAt    DateTime @default(now())

  // Taktik Coin: kayıt bonusu, günlük bonus, video ödülü, canlı hediyeler.
  coinBalance      Int       @default(0)
  lastDailyBonusAt DateTime?

  posts             Post[]
  likes             Like[]
  comments          Comment[]
  bookmarks         Bookmark[]
  commentLikes      CommentLike[]
  sentMessages      Message[]    @relation("SentMessages")
  receivedMessages  Message[]    @relation("ReceivedMessages")
  logs              Log[]        @relation("ActorLogs")
  targetLogs        Log[]        @relation("TargetLogs")

  // Takip sistemi
  following         Follow[]     @relation("Following")
  followers         Follow[]     @relation("Followers")

  // Bildirimler
  notifications     Notification[] @relation("ReceivedNotifications")
  sentNotifications Notification[] @relation("SentNotifications")

  // Canlı yayınlar
  liveRooms    LiveRoom[]    @relation("LiveAuthor")
  liveMessages LiveMessage[]
  liveViewers  LiveViewer[]
  liveVotes    LiveVote[]
  liveMutes    LiveMute[]

  // Coin hareketleri ve gönderilen hediyeler
  coinTransactions CoinTransaction[]
  sentGifts        LiveGift[]        @relation("GiftSender")

  // Hikayeler
  stories     Story[]     @relation("StoryAuthor")
  storyViews  StoryView[] @relation("StoryViewer")

  // Yaptığı şikayetler
  reports Report[] @relation("Reporter")

  // Engelleme
  blocking  Block[] @relation("Blocking")
  blockedBy Block[] @relation("BlockedBy")
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  videoUrl  String
  caption   String?
  viewCount Int      @default(0)
  // Medya türü: video veya image (fotoğraf/GIF).
  mediaType String   @default("video")
  // Ses adı (trend sesler sayfası için).
  sound     String?
  // Ses önizleme bağlantısı (dokununca çalar).
  soundUrl  String?
  // Coin ile öne çıkarma bitişi (bu tarihe kadar Keşfet'te üstte).
  promotedUntil DateTime?
  // Düet: bu video başka bir videoya tepki olarak çekildiyse orijinali.
  duetOfId String?
  createdAt DateTime @default(now())

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]
  bookmarks Bookmark[]
  duetOf    Post?      @relation("Duet", fields: [duetOfId], references: [id], onDelete: SetNull)
  duets     Post[]     @relation("Duet")

  @@index([sound])

  @@index([createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  type      NotificationType
  postId    String?
  commentId String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  // Tür: text (yazı), sticker (büyük emoji), gif (animasyon bağlantısı).
  kind       String   @default("text")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([createdAt])
}

model Log {
  id        String    @id @default(cuid())
  action    LogAction
  detail    String?
  actorId   String?
  targetId  String?
  createdAt DateTime  @default(now())

  actor  User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("TargetLogs", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Canlı yayın odası. Yayıncının seçtiği video izleyicilere oynatılır,
// sohbet canlı akar. Yayın açmak için 15 yaş ve üzeri gerekir.
model LiveRoom {
  id        String     @id @default(cuid())
  authorId  String
  title     String
  // Kamera yayınında boş olabilir (canlı görüntü LiveKit'ten gelir).
  videoUrl  String?
  status    LiveStatus @default(LIVE)
  likeCount Int        @default(0)
  // Yayın kategorisi: sohbet, oyun, müzik, spor, eğitim, yemek.
  category  String     @default("sohbet")
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  author   User          @relation("LiveAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  messages LiveMessage[]
  viewers  LiveViewer[]
  gifts    LiveGift[]
  polls    LivePoll[]
  mutes    LiveMute[]
  pkAsA    PkChallenge[] @relation("PkRoomA")
  pkAsB    PkChallenge[] @relation("PkRoomB")

  @@index([status, startedAt])
}

model LiveMessage {
  id        String   @id @default(cuid())
  roomId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model LiveViewer {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  lastSeen DateTime @default(now())

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, lastSeen])
}

// Hikayeler: 24 saat geçerli fotoğraf/video. Süresi dolanlar listelenmez.
model Story {
  id        String   @id @default(cuid())
  authorId  String
  mediaUrl  String
  mediaType String   @default("video")
  caption   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User        @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  views  StoryView[]

  @@index([expiresAt])
  @@index([authorId, createdAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}

// 🐺 Bozkurt Koruma: üye şikayetleri. Ekip inceler, sonuçlandırır.
model Report {
  id        String       @id @default(cuid())
  reporterId String
  target    ReportTarget
  targetId  String
  reason    String
  detail    String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
}

// Engelleme: iki yönlü görünmezlik (akış + mesaj).
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ⚔️ PK yarışması: iki canlı oda 5 dakika kapışır, skor = beğeni + hediye coini.
model PkChallenge {
  id         String   @id @default(cuid())
  roomAId    String
  roomBId    String
  status     PkStatus @default(PENDING)
  baseLikesA Int      @default(0)
  baseLikesB Int      @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())

  roomA LiveRoom @relation("PkRoomA", fields: [roomAId], references: [id], onDelete: Cascade)
  roomB LiveRoom @relation("PkRoomB", fields: [roomBId], references: [id], onDelete: Cascade)

  @@index([roomAId, status])
  @@index([roomBId, status])
}

// 📊 Canlı anket: yayıncı sorar, izleyiciler oylar.
model LivePoll {
  id        String   @id @default(cuid())
  roomId    String
  question  String
  options   Json
  endsAt    DateTime
  createdAt DateTime @default(now())

  room  LiveRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  votes LiveVote[]

  @@index([roomId, createdAt])
}

model LiveVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())

  poll LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([pollId])
}

// 🔇 Canlı susturma: yayıncı/ekip, taşkın üyeyi süreli susturur.
model LiveMute {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  until     DateTime
  createdAt DateTime @default(now())

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
}

// E-posta doğrulama kodları (6 haneli, 15 dakika geçerli).
model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Taktik Coin hareket defteri. Her coin değişimi buraya işlenir.
model CoinTransaction {
  id        String     @id @default(cuid())
  userId    String
  amount    Int
  reason    CoinReason
  note      String?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Canlı yayında gönderilen hediye. Ücret gönderenden düşer,
// yayıncıya coin olarak eklenir.
model LiveGift {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  gift      String
  count     Int      @default(1)
  cost      Int
  createdAt DateTime @default(now())

  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
